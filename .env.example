# ForkMyFolio Environment Variables (template)
# Copy to .env and fill in real values. NEVER commit .env.
# Every value below is a PLACEHOLDER — replace before use.

# ── Database ────────────────────────────────────────────────────────────────
# DB_PASSWORD seeds MYSQL_ROOT_PASSWORD (root/admin account, least-privilege:
# used only by the DB container itself).
DB_PASSWORD=change-me-strong-root-password
# DB_APP_PASSWORD is the application's MySQL account password (separate from
# root on purpose — the app never needs root).
DB_APP_PASSWORD=change-me-strong-app-db-password
DB_USERNAME=forkmyfolio

# ── Backend security ───────────────────────────────────────────────────────
# 96-byte Base64 (128 chars) — generate: openssl rand -base64 96
JWT_SECRET_KEY=change-me-random-96-byte-base64-secret
# Initial/synced admin password (single source of truth; DataInitializer
# force-syncs it to the admin account on every backend startup — change the
# .env value, not just the UI, or the next restart reverts your change).
ADMIN_PASSWORD=change-me-strong-admin-password
ADMIN_EMAIL=admin@example.com

# ── App configuration ──────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
SPRING_JPA_HIBERNATE_DDL_AUTO=update
# Comma-separated origins allowed by the browser-facing CORS policy
APP_CORS_ALLOWED_ORIGINS=https://portfolio.example.com

# ── Cookie settings ────────────────────────────────────────────────────────
# true behind HTTPS (rack/production), false for plain-HTTP local validation
APP_COOKIE_SECURE=false
# Shared cookie domain for cross-site deployments (detached SPA mode); leave commented for same-host
# APP_COOKIE_SAMESITE=Lax
# APP_SECURITY_COOKIE_DOMAIN=example.com

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Analytics credential encryption ──────────────────────────────────────
# AES-256-GCM key, Base64, exactly 32 bytes — generate: openssl rand -base64 32
# REQUIRED by the example compose (fail-fast guard). Rotating it invalidates
# stored analytics credentials.
ANALYTICS_ENCRYPTION_KEY=change-me-base64-32-byte-key

# ── Public site (Nuxt) ─────────────────────────────────────────────────────
# Allow search-engine crawling of the public portfolio (robots.txt, noindex,
# sitemap). Set to false for private/staging deployments.
NUXT_PUBLIC_INDEXABLE=true

# ── Host port ──────────────────────────────────────────────────────────────
# The single published port of the stack (the reverse proxy). Change this if
# the default is already in use on your machine.
FMF_HOST_PORT=8089

# ForkMyFolio Environment Variables (template)
# Copy to .env and fill in real values. NEVER commit .env.
# Every value below is a PLACEHOLDER — replace before use.

# ── Database ────────────────────────────────────────────────────────────────
# DB_PASSWORD seeds MYSQL_ROOT_PASSWORD (root/admin account, least-privilege:
# used only by the DB container itself).
DB_PASSWORD=change-me-strong-root-password
# DB_APP_PASSWORD is the application's MySQL account password (separate from
# root on purpose — the app never needs root).
DB_APP_PASSWORD=change-me-strong-app-db-password
DB_USERNAME=forkmyfolio

# ── Backend security ───────────────────────────────────────────────────────
# 96-byte Base64 (128 chars) — generate: openssl rand -base64 96
JWT_SECRET_KEY=change-me-random-96-byte-base64-secret
# Set-once initial admin password. DataInitializer seeds a NEW admin only:
# once the account exists this value is NOT re-synced, so rotate the password
# in the admin UI (a lost password needs a deliberate DB reset).
ADMIN_PASSWORD=change-me-strong-admin-password
ADMIN_EMAIL=admin@example.com

# ── App configuration ──────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
# Image default is `none` (Flyway-only). The example stack overrides it to
# `update`; set it to `none`/`validate` in your own stack for Flyway-only schema
# management.
SPRING_JPA_HIBERNATE_DDL_AUTO=update
# Optional (v1.2.11): per-IP auth-endpoint rate limit. Spring relaxed-binding
# names: APP_RATELIMIT_AUTHCAPACITY (default 120),
# APP_RATELIMIT_AUTHREFILL (120), APP_RATELIMIT_AUTHREFILLMINUTES (5).
# APP_RATELIMIT_AUTHCAPACITY=120
# APP_RATELIMIT_AUTHREFILL=120
# APP_RATELIMIT_AUTHREFILLMINUTES=5
# Optional: only set to a forwarded-header strategy if your outer proxy needs
# scheme/host forwarding. Default `none` prevents XFF bucket spoofing.
# FORWARD_HEADERS_STRATEGY=none
# Comma-separated origins allowed by the browser-facing CORS policy
APP_CORS_ALLOWED_ORIGINS=https://portfolio.example.com

# ── Cookie settings ────────────────────────────────────────────────────────
# true behind HTTPS (rack/production), false for plain-HTTP local validation
APP_COOKIE_SECURE=false
# Shared cookie domain for cross-site deployments (detached SPA mode); leave commented for same-host
# APP_COOKIE_SAMESITE=Lax
# APP_SECURITY_COOKIE_DOMAIN=example.com

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Analytics credential encryption ──────────────────────────────────────
# AES-256-GCM key, Base64, exactly 32 bytes — generate: openssl rand -base64 32
# REQUIRED by the example compose (fail-fast guard). Rotating it invalidates
# stored analytics credentials.
ANALYTICS_ENCRYPTION_KEY=change-me-base64-32-byte-key

# ── Social login / OIDC (optional; disabled by default) ───────────────────
# SPA (Vue admin): opt-in flags injected into public/config.js at container
# start. ONLY booleans and provider ids are exposed in built assets — never an
# issuer URL, client id or secret.
VITE_SOCIAL_LOGIN_ENABLED=false
VITE_SOCIAL_PROVIDERS=
# Nuxt public site: optional sign-in link to the SPA's /login page.
NUXT_PUBLIC_SOCIAL_LOGIN_ENABLED=false
# Backend provider registrations. Fill these in ONLY for providers you enable;
# real values belong here (git-ignored), never in a repository file or a
# frontend build. Register the callback URL with the provider out-of-band.
# KEYCLOAK_CLIENT_ID=change-me-client-id
# KEYCLOAK_CLIENT_SECRET=change-me-client-secret
# KEYCLOAK_ISSUER_URI=change-me-issuer-uri
# GOOGLE_CLIENT_ID=change-me-client-id
# GOOGLE_CLIENT_SECRET=change-me-client-secret
# GITHUB_CLIENT_ID=change-me-client-id
# GITHUB_CLIENT_SECRET=change-me-client-secret
# Comma-separated allowlist of callback redirect URIs (no frontend secrets).
# APP_OAUTH2_AUTHORIZEDREDIRECTURIS=

# ── Public site (Nuxt) ─────────────────────────────────────────────────────
# Allow search-engine crawling of the public portfolio (robots.txt, noindex,
# sitemap). Set to false for private/staging deployments.
NUXT_PUBLIC_INDEXABLE=true

# ── Host port ──────────────────────────────────────────────────────────────
# The single published port of the stack (the reverse proxy). Change this if
# the default is already in use on your machine.
FMF_HOST_PORT=8089
